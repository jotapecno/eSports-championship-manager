SELECT 
    j.id_jogador,
    j.nome_jogador,
    eq.id_equipe,
    eq.nome_equipe,
    fc.id_fase,
    fc.nome_fase,
    c.nome_campeonato,
    fc.status_fase
FROM 
    jogador j
INNER JOIN 
    equipe eq ON j.id_equipe = eq.id_equipe
INNER JOIN 
    equipe_fase ef ON eq.id_equipe = ef.id_equipe
INNER JOIN 
    fase_campeonato fc ON ef.id_fase = fc.id_fase
INNER JOIN 
    campeonato c ON fc.id_campeonato = c.id_campeonato
WHERE 
    fc.status_fase = 'ATIVA' 
    AND j.id_jogador = 10;
