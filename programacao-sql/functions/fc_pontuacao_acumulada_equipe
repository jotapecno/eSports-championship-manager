-- ============================================================
-- FUNCTION: fc_pontuacao_acumulada_equipe
-- Descrição: Retorna o total de pontos acumulados por uma equipe em um determinado campeonato.
-- Dependências de dados: Tabela classificacao_campeonato.
-- ============================================================

CREATE OR REPLACE FUNCTION fc_pontuacao_acumulada_equipe(p_equipe_id INT, p_campeonato_id INT)
RETURNS INT
LANGUAGE sql
AS $$
    SELECT COALESCE(SUM(pontos), 0)::INT
      FROM classificacao_campeonato
     WHERE equipe_id = p_equipe_id AND campeonato_id = p_campeonato_id;
$$;
