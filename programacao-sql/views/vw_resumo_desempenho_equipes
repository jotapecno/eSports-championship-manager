SELECT 
    e.id_equipe,
    e.nome_equipe,
 
    ROUND(
        (SUM(CASE WHEN p.id_equipe_vencedora = e.id_equipe THEN 1 ELSE 0 END) * 100.0) / 
        NULLIF(COUNT(p.id_partida), 0), 
        2
    ) AS win_rate_pct,

    COUNT(DISTINCT CASE WHEN c.id_equipe_campeao = e.id_equipe THEN c.id_campeonato END) AS total_titulos,
    
 
    COALESCE(SUM(pr.valor_premio), 0) AS total_premiacao
FROM 
    equipe e
LEFT JOIN 
    partida_equipe pe ON e.id_equipe = pe.id_equipe
LEFT JOIN 
    partida p ON pe.id_partida = p.id_partida
LEFT JOIN 
    campeonato c ON c.id_equipe_campeao = e.id_equipe
LEFT JOIN 
    premiacao pr ON e.id_equipe = pr.id_equipe
GROUP BY 
    e.id_equipe, 
    e.nome_equipe;
